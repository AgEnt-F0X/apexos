      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Teko:wght@400;600;700&display=swap');\n  @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&display=swap');\n\n  :root {\n    --bg-void: #0a0b0d;\n    --bg-carbon: #1B1B1B;\n    --accent: #ED1B24;\n    --text-hi: #ffffff;\n    --text-mid: #a0a0a0;\n    --text-lo: #606060;\n    --font-display: 'Teko', sans-serif;\n    --font-mono: 'JetBrains Mono', monospace;\n  }\n\n  body {\n    background-color: var(--bg-void);\n    color: var(--text-hi);\n    font-family: var(--font-mono);\n    margin: 0;\n    overflow: hidden;\n  }\n\n  /* Glassmorphism utility */\n  .glass {\n    background: rgba(18, 20, 24, 0.4);\n    backdrop-filter: blur(24px);\n    -webkit-backdrop-filter: blur(24px);\n    border: 0.5px solid rgba(255, 255, 255, 0.08);\n  }\n\n  /* Diagonal stripes motif */\n  .bg-stripes {\n    background-image: repeating-linear-gradient(45deg, transparent, transparent 10px, rgba(237, 27, 36, 0.03) 10px, rgba(237, 27, 36, 0.03) 20px);\n  }\n\n  /* Custom scrollbar for the archive */\n  .custom-scroll::-webkit-scrollbar {\n    width: 2px;\n  }\n  .custom-scroll::-webkit-scrollbar-track {\n    background: rgba(255, 255, 255, 0.02);\n  }\n  .custom-scroll::-webkit-scrollbar-thumb {\n    background: var(--accent);\n    opacity: 0.3;\n  }\n</style>\n<div class=\"h-screen w-full flex overflow-hidden\" data-kid=\"1\" data-name=\"page layout container\">\n    <!-- Left Panel (40%) -->\n    <aside class=\"w-[40%] h-full glass border-r border-white/5 z-20 flex flex-col p-16 overflow-y-auto relative custom-scroll\" data-kid=\"1-1\" data-name=\"left sidebar navigation panel\">\n        <!-- Branding -->\n        <div class=\"mb-14\" data-kid=\"1-1-1\" data-name=\"branding section\">\n            <h1 class=\"text-8xl font-bold tracking-tighter uppercase leading-[0.85] font-[var(--font-display)]\" data-kid=\"1-1-1-1\" data-name=\"site title\">\n                APEX\n                <span class=\"text-[var(--accent)]\" data-kid=\"1-1-1-1-1\" data-name=\"branding separator\">\n                    //\n                </span>\n                OS\n            </h1>\n            <div class=\"flex items-center gap-3 mt-4\" data-kid=\"1-1-1-2\" data-name=\"branding subtitle container\">\n                <div class=\"w-8 h-[1px] bg-[var(--accent)]\" data-kid=\"1-1-1-2-1\" data-name=\"subtitle accent line\">\n                </div>\n                <p class=\"text-[10px] tracking-[0.4em] font-bold text-[var(--accent)] uppercase\" data-kid=\"1-1-1-2-2\" data-name=\"branding subtitle\">\n                    F1 SPATIAL RACE INTELLIGENCE — CONCEPT 001\n                </p>\n            </div>\n        </div>\n        <!-- Intro -->\n        <div class=\"mb-16\" data-kid=\"1-1-2\" data-name=\"introductory description\">\n            <p class=\"text-[14px] text-[var(--text-mid)] leading-relaxed max-w-[42ch]\" data-kid=\"1-1-2-1\" data-name=\"introductory text\">\n                Every F1 session since 2023 broadcast ~500,000 rows of raw telemetry. \n        This machine replays them as a directed spatial broadcast — the race, as the pit wall sees it.\n            </p>\n        </div>\n        <!-- Latest Race Hero Card -->\n        <div class=\"relative group mb-14\" data-kid=\"1-1-3\" data-name=\"latest race hero card\">\n            <!-- Glow effect -->\n            <div class=\"absolute -top-[1px] left-0 w-full h-[1px] bg-[var(--accent)] shadow-[0_0_20px_var(--accent)] z-10\" data-kid=\"1-1-3-1\" data-name=\"hero card top glow border\">\n            </div>\n            <div class=\"glass p-10 relative overflow-hidden group-hover:bg-white/5 transition-all duration-500\" data-kid=\"1-1-3-2\" data-name=\"hero card content container\">\n                <!-- Abstract Shape Motif -->\n                <div class=\"absolute -top-4 -right-4 opacity-5 rotate-12 group-hover:scale-110 transition-transform duration-700\" data-kid=\"1-1-3-2-1\" data-name=\"abstract shape icon container\">\n                    <img class=\"w-32 h-32\" data-kid=\"1-1-3-2-1-1\" data-name=\"striped sword icon image\" src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/striped-sword.svg\" style=\"filter: invert(1);\"/>\n                </div>\n                <div class=\"flex items-center gap-2 mb-6\" data-kid=\"1-1-3-2-2\" data-name=\"hero card status indicator\">\n                    <span class=\"inline-block w-1.5 h-1.5 rounded-full bg-[var(--accent)] animate-pulse\" data-kid=\"1-1-3-2-2-1\" data-name=\"hero card status dot\">\n                    </span>\n                    <span class=\"text-[10px] tracking-[0.25em] text-[var(--accent)] font-bold uppercase\" data-kid=\"1-1-3-2-2-2\" data-name=\"hero card status label\">\n                        LATEST RACE · ARCHIVED LOCALLY\n                    </span>\n                </div>\n                <h2 class=\"text-5xl font-bold text-white uppercase mb-3 font-[var(--font-display)] tracking-tight\" data-kid=\"1-1-3-2-3\" data-name=\"hero card main title\">\n                    SÃO PAULO 2024\n                </h2>\n                <p class=\"text-[11px] text-[var(--text-lo)] mb-10 tracking-[0.15em] font-bold uppercase\" data-kid=\"1-1-3-2-4\" data-name=\"hero card subtitle\">\n                    THE MOST RECENT GRAND PRIX ON RECORD\n                </p>\n                <div class=\"flex gap-5\" data-kid=\"1-1-3-2-5\" data-name=\"hero card action buttons container\">\n                    <button class=\"bg-[var(--accent)] hover:bg-red-700 transition-all duration-300 px-8 py-4 text-xs font-bold uppercase tracking-[0.2em] font-[var(--font-display)] text-white hover:translate-y-[-2px] hover:shadow-[0_8px_20px_rgba(237,27,36,0.3)]\" data-kid=\"1-1-3-2-5-1\" data-name=\"enter theatre button\">\n                        ENTER THEATRE ↗\n                    </button>\n                    <button class=\"border border-white/20 hover:border-[var(--accent)] hover:text-[var(--accent)] transition-all duration-300 px-8 py-4 text-xs font-bold uppercase tracking-[0.2em] font-[var(--font-display)] text-white/60\" data-kid=\"1-1-3-2-5-2\" data-name=\"join as live button\">\n                        ⦿ JOIN AS LIVE\n                    </button>\n                </div>\n            </div>\n        </div>\n        <!-- Signature Replay -->\n        <button class=\"text-left group mb-20 flex items-center gap-6 hover:translate-x-1 transition-transform duration-300\" data-kid=\"1-1-4\" data-name=\"signature replay trigger\">\n            <div class=\"w-10 h-10 border border-white/10 flex items-center justify-center group-hover:border-[var(--accent)] transition-colors\" data-kid=\"1-1-4-1\" data-name=\"signature replay icon container\">\n                <i class=\"ti ti-activity text-[var(--text-lo)] group-hover:text-[var(--accent)] transition-colors\" data-kid=\"1-1-4-1-1\" data-name=\"activity icon\">\n                </i>\n            </div>\n            <div data-kid=\"1-1-4-2\" data-name=\"signature replay description\">\n                <span class=\"text-[9px] text-[var(--text-lo)] uppercase block mb-1 tracking-widest\" data-kid=\"1-1-4-2-1\" data-name=\"signature replay label\">\n                    OR RELIVE THE SIGNATURE REPLAY\n                </span>\n                <span class=\"text-xl font-bold group-hover:text-[var(--accent)] transition-colors uppercase font-[var(--font-display)] tracking-wide\" data-kid=\"1-1-4-2-2\" data-name=\"signature replay title\">\n                    SÃO PAULO 2024 · RAIN DRAMA\n                </span>\n                <div class=\"flex items-center gap-2 mt-1\" data-kid=\"1-1-4-2-3\" data-name=\"signature replay highlight\">\n                    <span class=\"text-[10px] text-[var(--text-mid)] uppercase\" data-kid=\"1-1-4-2-3-1\" data-name=\"signature replay result text\">\n                        VERSTAPPEN P17 → P1\n                    </span>\n                </div>\n            </div>\n        </button>\n        <!-- Archive Timeline Section -->\n        <div class=\"flex-1\" data-kid=\"1-1-5\" data-name=\"archive timeline container\">\n            <div class=\"flex items-center justify-between mb-10 border-b border-white/5 pb-4\" data-kid=\"1-1-5-1\" data-name=\"timeline header\">\n                <span class=\"text-[11px] font-bold tracking-[0.3em] uppercase text-white/80\" data-kid=\"1-1-5-1-1\" data-name=\"timeline section label\">\n                    SESSION ARCHIVE\n                </span>\n                <div class=\"flex gap-6\" data-kid=\"1-1-5-1-2\" data-name=\"year filter buttons container\">\n                    <button class=\"text-[var(--accent)] font-bold text-xs tracking-widest relative\" data-kid=\"1-1-5-1-2-1\" data-name=\"active year button\">\n                        2026\n                        <span class=\"absolute -bottom-[17px] left-0 w-full h-[2px] bg-[var(--accent)]\" data-kid=\"1-1-5-1-2-1-1\" data-name=\"active year indicator line\">\n                        </span>\n                    </button>\n                    <button class=\"text-[var(--text-lo)] hover:text-white transition-colors text-xs tracking-widest\" data-kid=\"1-1-5-1-2-2\" data-name=\"inactive year button\">\n                        2025\n                    </button>\n                    <button class=\"text-[var(--text-lo)] hover:text-white transition-colors text-xs tracking-widest\" data-kid=\"1-1-5-1-2-3\" data-name=\"inactive year button\">\n                        2024\n                    </button>\n                </div>\n            </div>\n            <!-- Technical Vertical Timeline -->\n            <div class=\"relative pl-8\" data-kid=\"1-1-5-2\" data-name=\"technical vertical timeline\">\n                <!-- Vertical Axis -->\n                <div class=\"absolute left-0 top-0 w-[1px] h-full bg-gradient-to-b from-[var(--accent)]/60 via-[var(--accent)]/10 to-transparent\" data-kid=\"1-1-5-2-1\" data-name=\"vertical axis line\">\n                </div>\n                <div class=\"space-y-12\" data-kid=\"1-1-5-2-2\" data-name=\"meetings list container\">\n                    <!-- Meeting Row 01 -->\n                    <div class=\"relative group cursor-pointer\" data-kid=\"1-1-5-2-2-1\" data-name=\"meeting row\">\n                        <!-- Connector Dot -->\n                        <div class=\"absolute -left-[35.5px] top-2 w-4 h-4 rounded-none border border-[var(--accent)] bg-[var(--bg-void)] group-hover:rotate-45 transition-transform duration-500 z-10\" data-kid=\"1-1-5-2-2-1-1\" data-name=\"meeting connector dot\">\n                            <div class=\"absolute inset-1 bg-[var(--accent)] opacity-40\" data-kid=\"1-1-5-2-2-1-1-1\" data-name=\"meeting connector dot inner\">\n                            </div>\n                        </div>\n                        <div class=\"flex flex-col gap-1 group-hover:pl-2 transition-all duration-300\" data-kid=\"1-1-5-2-2-1-2\" data-name=\"meeting details container\">\n                            <span class=\"text-[10px] text-[var(--text-lo)] font-bold tracking-widest\" data-kid=\"1-1-5-2-2-1-2-1\" data-name=\"meeting status label\">\n                                ROUND 01 · COMPLETED\n                            </span>\n                            <h3 class=\"text-2xl font-bold uppercase group-hover:text-[var(--accent)] transition-colors font-[var(--font-display)] tracking-wider\" data-kid=\"1-1-5-2-2-1-2-2\" data-name=\"meeting title\">\n                                BAHRAIN GRAND PRIX\n                            </h3>\n                            <div class=\"flex items-center gap-3 text-[10px] text-[var(--text-mid)] uppercase tracking-wider\" data-kid=\"1-1-5-2-2-1-2-3\" data-name=\"meeting meta info\">\n                                <span data-kid=\"1-1-5-2-2-1-2-3-1\" data-name=\"meeting location\">\n                                    SAKHIR · BAHRAIN\n                                </span>\n                                <span class=\"opacity-30\" data-kid=\"1-1-5-2-2-1-2-3-2\" data-name=\"meeting meta separator\">\n                                    /\n                                </span>\n                                <span class=\"text-[var(--accent)] font-bold\" data-kid=\"1-1-5-2-2-1-2-3-3\" data-name=\"meeting session count\">\n                                    5 SESSIONS\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                    <!-- Meeting Row 02 -->\n                    <div class=\"relative group cursor-pointer\" data-kid=\"1-1-5-2-2-2\" data-name=\"meeting row\">\n                        <!-- Connector Dot -->\n                        <div class=\"absolute -left-[33.5px] top-3 w-2 h-2 rounded-none border border-white/20 bg-[var(--bg-void)] group-hover:border-[var(--accent)] transition-all duration-500 z-10\" data-kid=\"1-1-5-2-2-2-1\" data-name=\"meeting connector dot\">\n                        </div>\n                        <div class=\"flex flex-col gap-1 group-hover:pl-2 transition-all duration-300 opacity-60 group-hover:opacity-100\" data-kid=\"1-1-5-2-2-2-2\" data-name=\"meeting details container\">\n                            <span class=\"text-[10px] text-[var(--text-lo)] font-bold tracking-widest\" data-kid=\"1-1-5-2-2-2-2-1\" data-name=\"meeting status label\">\n                                ROUND 02 · COMPLETED\n                            </span>\n                            <h3 class=\"text-2xl font-bold uppercase group-hover:text-[var(--accent)] transition-colors font-[var(--font-display)] tracking-wider\" data-kid=\"1-1-5-2-2-2-2-2\" data-name=\"meeting title\">\n                                SAUDI ARABIAN GP\n                            </h3>\n                            <div class=\"flex items-center gap-3 text-[10px] text-[var(--text-mid)] uppercase tracking-wider\" data-kid=\"1-1-5-2-2-2-2-3\" data-name=\"meeting meta info\">\n                                <span data-kid=\"1-1-5-2-2-2-2-3-1\" data-name=\"meeting location\">\n                                    JEDDAH · SAUDI ARABIA\n                                </span>\n                                <span class=\"opacity-30\" data-kid=\"1-1-5-2-2-2-2-3-2\" data-name=\"meeting meta separator\">\n                                    /\n                                </span>\n                                <span class=\"text-[var(--text-lo)]\" data-kid=\"1-1-5-2-2-2-2-3-3\" data-name=\"meeting session status\">\n                                    UNLOADED\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                    <!-- Meeting Row 03 -->\n                    <div class=\"relative group cursor-pointer\" data-kid=\"1-1-5-2-2-3\" data-name=\"meeting row\">\n                        <div class=\"absolute -left-[33.5px] top-3 w-2 h-2 rounded-none border border-white/20 bg-[var(--bg-void)] group-hover:border-[var(--accent)] transition-all duration-500 z-10\" data-kid=\"1-1-5-2-2-3-1\" data-name=\"meeting connector dot\">\n                        </div>\n                        <div class=\"flex flex-col gap-1 group-hover:pl-2 transition-all duration-300 opacity-60 group-hover:opacity-100\" data-kid=\"1-1-5-2-2-3-2\" data-name=\"meeting details container\">\n                            <span class=\"text-[10px] text-[var(--text-lo)] font-bold tracking-widest\" data-kid=\"1-1-5-2-2-3-2-1\" data-name=\"meeting status label\">\n                                ROUND 03 · COMPLETED\n                            </span>\n                            <h3 class=\"text-2xl font-bold uppercase group-hover:text-[var(--accent)] transition-colors font-[var(--font-display)] tracking-wider\" data-kid=\"1-1-5-2-2-3-2-2\" data-name=\"meeting title\">\n                                AUSTRALIAN GP\n                            </h3>\n                            <div class=\"flex items-center gap-3 text-[10px] text-[var(--text-mid)] uppercase tracking-wider\" data-kid=\"1-1-5-2-2-3-2-3\" data-name=\"meeting meta info\">\n                                <span data-kid=\"1-1-5-2-2-3-2-3-1\" data-name=\"meeting location\">\n                                    MELBOURNE · AUSTRALIA\n                                </span>\n                                <span class=\"opacity-30\" data-kid=\"1-1-5-2-2-3-2-3-2\" data-name=\"meeting meta separator\">\n                                    /\n                                </span>\n                                <span class=\"text-[var(--text-lo)]\" data-kid=\"1-1-5-2-2-3-2-3-3\" data-name=\"meeting session status\">\n                                    UNLOADED\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <!-- Footer -->\n        <footer class=\"mt-20 pt-8 border-t border-white/5 flex justify-between items-center text-[10px] text-[var(--text-lo)] uppercase tracking-[0.2em] font-bold\" data-kid=\"1-1-6\" data-name=\"sidebar footer\">\n            <div class=\"flex gap-8\" data-kid=\"1-1-6-1\" data-name=\"footer info container\">\n                <span data-kid=\"1-1-6-1-1\" data-name=\"data source text\">\n                    DATA · OPENF1.ORG API\n                </span>\n                <span class=\"opacity-30\" data-kid=\"1-1-6-1-2\" data-name=\"footer separator\">\n                    |\n                </span>\n                <span data-kid=\"1-1-6-1-3\" data-name=\"system status text\">\n                    SYSTEM STATUS: STABLE\n                </span>\n            </div>\n            <button class=\"hover:text-[var(--accent)] transition-colors flex items-center gap-2\" data-kid=\"1-1-6-2\" data-name=\"about link button\">\n                ABOUT THIS CONCEPT\n                <i class=\"ti ti-chevron-right text-[8px]\" data-kid=\"1-1-6-2-1\" data-name=\"chevron icon\">\n                </i>\n            </button>\n        </footer>\n    </aside>\n    <!-- Right Panel (60%) - Cinematic Background -->\n    <main class=\"flex-1 h-full relative overflow-hidden bg-[var(--bg-void)]\" data-kid=\"1-2\" data-name=\"right cinematic main content panel\">\n        <!-- Cinematic Video Background -->\n        <div class=\"absolute inset-0 z-0\" data-kid=\"1-2-1\" data-name=\"video background container\">\n            <video autoplay=\"\" class=\"absolute inset-0 w-full h-full object-cover scale-105\" data-kid=\"1-2-1-1\" data-name=\"background video element\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://images.pexels.com/videos/34127955/abstract-analysis-analytics-background-34127955.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" preload=\"metadata\" src=\"https://videos.pexels.com/video-files/34127955/14471454_640_360_30fps.mp4\">\n            </video>\n            <!-- Gradient Overlays for Cinematic Feel -->\n            <div class=\"absolute inset-0 bg-gradient-to-r from-[var(--bg-void)] via-[var(--bg-void)]/40 to-transparent z-10 w-[40%]\" data-kid=\"1-2-1-2\" data-name=\"horizontal gradient overlay\">\n            </div>\n            <div class=\"absolute inset-0 bg-gradient-to-t from-[var(--bg-void)] via-transparent to-transparent z-10 h-[30%]\" data-kid=\"1-2-1-3\" data-name=\"vertical gradient overlay\">\n            </div>\n            <div class=\"absolute inset-0 bg-black/20 z-0\" data-kid=\"1-2-1-4\" data-name=\"dark shadow overlay\">\n            </div>\n        </div>\n        <!-- Technical Motif Overlays -->\n        <div class=\"absolute inset-0 opacity-[0.07] pointer-events-none z-10 bg-stripes\" data-kid=\"1-2-2\" data-name=\"technical stripe motif overlay\">\n        </div>\n        <!-- Floating Cinematic Stats (Right-aligned metadata) -->\n        <div class=\"absolute bottom-16 right-16 z-20 flex flex-col items-end text-right gap-12\" data-kid=\"1-2-3\" data-name=\"floating stats panel\">\n            <!-- Primary Stat Block -->\n            <div class=\"flex flex-col gap-2\" data-kid=\"1-2-3-1\" data-name=\"primary stat block\">\n                <div class=\"flex items-center gap-3 self-end\" data-kid=\"1-2-3-1-1\" data-name=\"system throughput label container\">\n                    <div class=\"w-12 h-[1px] bg-[var(--accent)]/50\" data-kid=\"1-2-3-1-1-1\" data-name=\"throughput accent line\">\n                    </div>\n                    <span class=\"text-[11px] text-[var(--accent)] font-bold tracking-[0.4em] uppercase\" data-kid=\"1-2-3-1-1-2\" data-name=\"throughput label text\">\n                        SYSTEM THROUGHPUT\n                    </span>\n                </div>\n                <div class=\"flex items-baseline gap-2\" data-kid=\"1-2-3-1-2\" data-name=\"throughput stats row\">\n                    <span class=\"text-7xl font-bold font-[var(--font-display)] leading-none text-white tracking-tighter\" data-kid=\"1-2-3-1-2-1\" data-name=\"throughput numerical value\">\n                        1.4M\n                    </span>\n                    <span class=\"text-xl font-bold font-[var(--font-display)] text-[var(--text-mid)] uppercase\" data-kid=\"1-2-3-1-2-2\" data-name=\"throughput unit text\">\n                        ROWS/SESSION\n                    </span>\n                </div>\n            </div>\n            <!-- Secondary Metrics Grid -->\n            <div class=\"grid grid-cols-2 gap-x-16 gap-y-4\" data-kid=\"1-2-3-2\" data-name=\"secondary metrics grid\">\n                <div class=\"flex flex-col gap-1\" data-kid=\"1-2-3-2-1\" data-name=\"metric block\">\n                    <span class=\"text-[10px] text-[var(--text-lo)] font-bold tracking-[0.2em] uppercase\" data-kid=\"1-2-3-2-1-1\" data-name=\"metric label\">\n                        TELEMETRY POLLING\n                    </span>\n                    <span class=\"text-3xl font-bold font-[var(--font-display)] text-white tracking-wide\" data-kid=\"1-2-3-2-1-2\" data-name=\"metric value\">\n                        5.0 HZ\n                    </span>\n                </div>\n                <div class=\"flex flex-col gap-1\" data-kid=\"1-2-3-2-2\" data-name=\"metric block\">\n                    <span class=\"text-[10px] text-[var(--text-lo)] font-bold tracking-[0.2em] uppercase\" data-kid=\"1-2-3-2-2-1\" data-name=\"metric label\">\n                        SPATIAL PRECISION\n                    </span>\n                    <span class=\"text-3xl font-bold font-[var(--font-display)] text-white tracking-wide\" data-kid=\"1-2-3-2-2-2\" data-name=\"metric value\">\n                        10 CM\n                    </span>\n                </div>\n                <div class=\"flex flex-col gap-1\" data-kid=\"1-2-3-2-3\" data-name=\"metric block\">\n                    <span class=\"text-[10px] text-[var(--text-lo)] font-bold tracking-[0.2em] uppercase\" data-kid=\"1-2-3-2-3-1\" data-name=\"metric label\">\n                        API LATENCY\n                    </span>\n                    <span class=\"text-3xl font-bold font-[var(--font-display)] text-white tracking-wide\" data-kid=\"1-2-3-2-3-2\" data-name=\"metric value\">\n                        0.2 MS\n                    </span>\n                </div>\n                <div class=\"flex flex-col gap-1\" data-kid=\"1-2-3-2-4\" data-name=\"metric block\">\n                    <span class=\"text-[10px] text-[var(--text-lo)] font-bold tracking-[0.2em] uppercase\" data-kid=\"1-2-3-2-4-1\" data-name=\"metric label\">\n                        DATA PACKING\n                    </span>\n                    <span class=\"text-3xl font-bold font-[var(--font-display)] text-white tracking-wide\" data-kid=\"1-2-3-2-4-2\" data-name=\"metric value\">\n                        BINARY\n                    </span>\n                </div>\n            </div>\n            <!-- Live Scanline Effect -->\n            <div class=\"w-full h-[1px] bg-white/10 relative overflow-hidden mt-4\" data-kid=\"1-2-3-3\" data-name=\"live scanline container\">\n                <div class=\"absolute inset-0 w-24 h-full bg-[var(--accent)] animate-[scan_3s_infinite_linear]\" data-kid=\"1-2-3-3-1\" data-name=\"animated scanline element\">\n                </div>\n            </div>\n        </div>\n        <!-- Decorative Corner Marks -->\n        <div class=\"absolute top-12 right-12 w-8 h-8 border-t border-r border-white/20 z-20 opacity-30\" data-kid=\"1-2-4\" data-name=\"top-right decorative corner mark\">\n        </div>\n        <div class=\"absolute bottom-12 left-12 w-8 h-8 border-b border-l border-white/20 z-20 opacity-30\" data-kid=\"1-2-5\" data-name=\"bottom-left decorative corner mark\">\n        </div>\n    </main>\n</div>\n<style>\n    @keyframes scan {\n    0% { transform: translateX(-100%); }\n    100% { transform: translateX(500%); }\n  }\n</style>\n<link data-kid=\"2\" data-name=\"tabler icon stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n",
      "comments": [],
      "created": "2026-07-20T20:46:38.031897+00:00",
      "modified": "2026-07-20T20:47:07.794060+00:00",
      "id": "var_23dedbbc741c"
    }
  },
  "comments": [],
  "nextCommentNumber": 1
}