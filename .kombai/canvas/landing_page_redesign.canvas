      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Passion+One:wght@400;700;900&family=JetBrains+Mono:wght@400;700&family=Inter:wght@400;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --bg-void: #000000;\n    --bg-surface: #1b1d22;\n    --accent: #e10600;\n    --amber: #d78f00;\n    --text-hi: #ffffff;\n    --text-mid: #8a94a3;\n    --text-lo: #4c5766;\n  }\n\n  body {\n    background-color: var(--bg-void);\n    color: var(--text-hi);\n    font-family: 'Inter', sans-serif;\n    margin: 0;\n    overflow: hidden;\n    height: 100vh;\n  }\n\n  .mono { font-family: 'JetBrains Mono', monospace; }\n  .display { font-family: 'Passion One', sans-serif; }\n\n  @keyframes radar-sweep {\n    from { transform: rotate(0deg); }\n    to { transform: rotate(360deg); }\n  }\n\n  .radar-sweep {\n    background: conic-gradient(from 0deg, transparent 0%, rgba(225, 6, 0, 0.08) 30%, transparent 60%);\n    animation: radar-sweep 10s linear infinite;\n  }\n\n  .scanline {\n    width: 100%;\n    height: 100px;\n    background: linear-gradient(to bottom, transparent, rgba(225, 6, 0, 0.03), transparent);\n    position: absolute;\n    top: -100px;\n    left: 0;\n    animation: scanline 6s linear infinite;\n  }\n\n  @keyframes scanline {\n    0% { top: -100px; }\n    100% { top: 100%; }\n  }\n\n  .reticle-corner {\n    position: absolute;\n    width: 20px;\n    height: 20px;\n    border-color: var(--accent);\n    border-style: solid;\n  }\n\n  .reticle-tl { top: -1px; left: -1px; border-width: 2px 0 0 2px; }\n  .reticle-tr { top: -1px; right: -1px; border-width: 2px 2px 0 0; }\n  .reticle-bl { bottom: -1px; left: -1px; border-width: 0 0 2px 2px; }\n  .reticle-br { bottom: -1px; right: -1px; border-width: 0 2px 2px 0; }\n\n  .connector-line {\n    position: absolute;\n    background: rgba(255, 255, 255, 0.1);\n  }\n\n  .blink {\n    animation: blink 1.5s step-start infinite;\n  }\n\n  @keyframes blink {\n    50% { opacity: 0; }\n  }\n</style>\n<div class=\"relative w-full h-screen overflow-hidden bg-[#000000]\" data-kid=\"1\" data-name=\"page layout container\">\n    <!-- Immersive Radial Background -->\n    <div class=\"absolute inset-0 flex items-center justify-center opacity-40\" data-kid=\"1-1\" data-name=\"immersive radial background container\">\n        <!-- Concentric Circles -->\n        <div class=\"absolute w-[1200px] h-[1200px] border border-white/5 rounded-full\" data-kid=\"1-1-1\" data-name=\"concentric circle\">\n        </div>\n        <div class=\"absolute w-[1000px] h-[1000px] border border-white/5 rounded-full\" data-kid=\"1-1-2\" data-name=\"concentric circle\">\n        </div>\n        <div class=\"absolute w-[800px] h-[800px] border border-white/10 rounded-full\" data-kid=\"1-1-3\" data-name=\"concentric circle\">\n        </div>\n        <div class=\"absolute w-[600px] h-[600px] border border-white/10 rounded-full flex items-center justify-center\" data-kid=\"1-1-4\" data-name=\"concentric circle container\">\n            <!-- Inner reticle ring -->\n            <div class=\"w-full h-full border border-white/20 rounded-full radar-sweep\" data-kid=\"1-1-4-1\" data-name=\"radar sweep animation ring\">\n            </div>\n        </div>\n        <!-- Radial Crosshairs -->\n        <div class=\"absolute w-full h-[1px] bg-white/5\" data-kid=\"1-1-5\" data-name=\"horizontal crosshair line\">\n        </div>\n        <div class=\"absolute w-[1px] h-full bg-white/5\" data-kid=\"1-1-6\" data-name=\"vertical crosshair line\">\n        </div>\n    </div>\n    <div class=\"scanline\" data-kid=\"1-2\" data-name=\"vertical scanline animation\">\n    </div>\n    <!-- Primary Layout: Centered focal point -->\n    <div class=\"relative z-10 flex flex-col items-center justify-center h-full px-12\" data-kid=\"1-3\" data-name=\"focal point layout container\">\n        <!-- Branding -->\n        <div class=\"mb-12 text-center\" data-kid=\"1-3-1\" data-name=\"branding section\">\n            <h1 class=\"display text-[120px] leading-none tracking-tighter text-white uppercase select-none\" data-kid=\"1-3-1-1\" data-name=\"hero headline text\">\n                APEX\n                <span class=\"text-[#e10600] tracking-[-0.1em] mx-[-0.05em]\" data-kid=\"1-3-1-1-1\" data-name=\"accent separator icon\">\n                    //\n                </span>\n                OS\n            </h1>\n            <p class=\"mono text-[14px] tracking-[0.4em] text-white/40 mt-2 uppercase\" data-kid=\"1-3-1-2\" data-name=\"hero subheadline text\">\n                F1 SPATIAL RACE INTELLIGENCE · CONCEPT 001\n            </p>\n        </div>\n        <!-- Central Targeting Reticle / Hero -->\n        <div class=\"relative group\" data-kid=\"1-3-2\" data-name=\"targeting reticle container\">\n            <!-- Reticle corners -->\n            <div class=\"reticle-corner reticle-tl\" data-kid=\"1-3-2-1\" data-name=\"top-left reticle corner\">\n            </div>\n            <div class=\"reticle-corner reticle-tr\" data-kid=\"1-3-2-2\" data-name=\"top-right reticle corner\">\n            </div>\n            <div class=\"reticle-corner reticle-bl\" data-kid=\"1-3-2-3\" data-name=\"bottom-left reticle corner\">\n            </div>\n            <div class=\"reticle-corner reticle-br\" data-kid=\"1-3-2-4\" data-name=\"bottom-right reticle corner\">\n            </div>\n            <div class=\"relative w-[640px] bg-[#1b1d22]/80 backdrop-blur-2xl border border-white/10 overflow-hidden shadow-2xl transition-all duration-500 group-hover:border-[#e10600]/40 group-hover:scale-[1.02]\" data-kid=\"1-3-2-5\" data-name=\"content card container\">\n                <!-- Hero Image Overlay -->\n                <div class=\"absolute inset-0 opacity-20 group-hover:opacity-30 transition-opacity\" data-kid=\"1-3-2-5-1\" data-name=\"hero image background container\">\n                    <img alt=\"Night Race\" class=\"w-full h-full object-cover grayscale\" data-kid=\"1-3-2-5-1-1\" data-name=\"hero background image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1699138346782-8a8b211c3da2?auto=format&w=800&q=80&fit=crop\"/>\n                </div>\n                <div class=\"relative p-8 flex flex-col gap-6\" data-kid=\"1-3-2-5-2\" data-name=\"content card inner layout\">\n                    <div class=\"flex justify-between items-start\" data-kid=\"1-3-2-5-2-1\" data-name=\"card header container\">\n                        <div class=\"flex flex-col gap-1\" data-kid=\"1-3-2-5-2-1-1\" data-name=\"card title group\">\n                            <span class=\"mono text-[10px] text-[#e10600] font-bold tracking-[0.2em] uppercase\" data-kid=\"1-3-2-5-2-1-1-1\" data-name=\"target status label\">\n                                SYSTEM TARGET ACQUIRED\n                            </span>\n                            <h2 class=\"display text-[48px] leading-tight text-white uppercase\" data-kid=\"1-3-2-5-2-1-1-2\" data-name=\"grand prix title\">\n                                SÃO PAULO GP 2024\n                            </h2>\n                        </div>\n                        <div class=\"text-right\" data-kid=\"1-3-2-5-2-1-2\" data-name=\"performance metrics container\">\n                            <span class=\"mono text-[10px] text-white/40 uppercase\" data-kid=\"1-3-2-5-2-1-2-1\" data-name=\"latency metric label\">\n                                LATENCY: 14MS\n                            </span>\n                            <div class=\"mono text-[18px] text-white font-bold\" data-kid=\"1-3-2-5-2-1-2-2\" data-name=\"position delta indicator\">\n                                P17\n                                <i class=\"ti ti-arrow-right text-[#e10600]\" data-kid=\"1-3-2-5-2-1-2-2-1\" data-name=\"arrow right icon\">\n                                </i>\n                                P01\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"h-[1px] w-full bg-white/10\" data-kid=\"1-3-2-5-2-2\" data-name=\"horizontal card divider\">\n                    </div>\n                    <div class=\"flex flex-col gap-4\" data-kid=\"1-3-2-5-2-3\" data-name=\"content footer container\">\n                        <p class=\"mono text-[12px] text-white/60 leading-relaxed max-w-[48ch]\" data-kid=\"1-3-2-5-2-3-1\" data-name=\"card description text\">\n                            VERSTAPPEN · INTERMEDIATE STINT · 69 LAPS · HEAVY RAIN. \n                        REPLAYING 1,398,809 ROWS OF SPATIAL TELEMETRY DATA.\n                        </p>\n                        <div class=\"flex gap-3\" data-kid=\"1-3-2-5-2-3-2\" data-name=\"call to action button container\">\n                            <button class=\"flex-1 bg-[#e10600] text-white mono font-bold text-[13px] py-4 tracking-[0.1em] hover:bg-white hover:text-black transition-all uppercase\" data-kid=\"1-3-2-5-2-3-2-1\" data-name=\"launch theatre button\">\n                                LAUNCH THEATRE ↗\n                            </button>\n                            <button class=\"px-6 border border-[#e10600]/40 text-[#e10600] mono font-bold text-[13px] hover:bg-[#e10600]/10 transition-all uppercase flex items-center gap-2\" data-kid=\"1-3-2-5-2-3-2-2\" data-name=\"join live button\">\n                                <span class=\"w-2 h-2 bg-[#e10600] rounded-full blink\" data-kid=\"1-3-2-5-2-3-2-2-1\" data-name=\"live status blinker\">\n                                </span>\n                                JOIN AS LIVE\n                            </button>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <!-- Reticle Crosshairs extending from the hero -->\n            <div class=\"absolute top-1/2 -left-20 w-20 h-[1px] bg-[#e10600]/40\" data-kid=\"1-3-2-6\" data-name=\"left crosshair extension\">\n            </div>\n            <div class=\"absolute top-1/2 -right-20 w-20 h-[1px] bg-[#e10600]/40\" data-kid=\"1-3-2-7\" data-name=\"right crosshair extension\">\n            </div>\n        </div>\n        <!-- Secondary Navigation / Signatures -->\n        <div class=\"mt-16 flex gap-12\" data-kid=\"1-3-3\" data-name=\"secondary navigation container\">\n            <div class=\"flex items-center gap-4 group cursor-pointer\" data-kid=\"1-3-3-1\" data-name=\"signature replay link group\">\n                <div class=\"w-12 h-12 rounded-full border border-white/10 flex items-center justify-center group-hover:border-[#e10600]/60 transition-all\" data-kid=\"1-3-3-1-1\" data-name=\"icon wrapper container\">\n                    <i class=\"ti ti-activity text-white/40 group-hover:text-[#e10600]\" data-kid=\"1-3-3-1-1-1\" data-name=\"activity icon\">\n                    </i>\n                </div>\n                <div data-kid=\"1-3-3-1-2\" data-name=\"link text group\">\n                    <span class=\"mono text-[10px] text-white/30 uppercase tracking-[0.1em]\" data-kid=\"1-3-3-1-2-1\" data-name=\"link label\">\n                        SIGNATURE REPLAY\n                    </span>\n                    <div class=\"text-[14px] font-bold text-white group-hover:text-[#e10600] transition-all\" data-kid=\"1-3-3-1-2-2\" data-name=\"link title\">\n                        SÃO PAULO 2024\n                    </div>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-4 group cursor-pointer\" data-kid=\"1-3-3-2\" data-name=\"archive link group\">\n                <div class=\"w-12 h-12 rounded-full border border-white/10 flex items-center justify-center group-hover:border-[#d78f00]/60 transition-all\" data-kid=\"1-3-3-2-1\" data-name=\"icon wrapper container\">\n                    <i class=\"ti ti-crosshair text-white/40 group-hover:text-[#d78f00]\" data-kid=\"1-3-3-2-1-1\" data-name=\"crosshair icon\">\n                    </i>\n                </div>\n                <div data-kid=\"1-3-3-2-2\" data-name=\"link text group\">\n                    <span class=\"mono text-[10px] text-white/30 uppercase tracking-[0.1em]\" data-kid=\"1-3-3-2-2-1\" data-name=\"link label\">\n                        THE ARCHIVE\n                    </span>\n                    <div class=\"text-[14px] font-bold text-white group-hover:text-[#d78f00] transition-all\" data-kid=\"1-3-3-2-2-2\" data-name=\"link title\">\n                        2023 → PRESENT\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n    <!-- Orbiting Archive (Left Aligned technical list) -->\n    <div class=\"absolute left-12 top-1/2 -translate-y-1/2 z-20 w-[280px]\" data-kid=\"1-4\" data-name=\"database archive sidebar\">\n        <div class=\"flex flex-col gap-8\" data-kid=\"1-4-1\" data-name=\"sidebar inner list\">\n            <!-- Years Section -->\n            <div class=\"flex flex-col gap-4\" data-kid=\"1-4-1-1\" data-name=\"years section group\">\n                <div class=\"flex items-center gap-3\" data-kid=\"1-4-1-1-1\" data-name=\"section header container\">\n                    <div class=\"w-3 h-3 rounded-full border-2 border-[#e10600] bg-black\" data-kid=\"1-4-1-1-1-1\" data-name=\"status dot\">\n                    </div>\n                    <span class=\"mono text-[11px] font-bold text-white uppercase tracking-[0.2em]\" data-kid=\"1-4-1-1-1-2\" data-name=\"section label\">\n                        DATABASE ARCHIVE\n                    </span>\n                </div>\n                <div class=\"flex flex-col gap-0 border-l border-white/10 ml-[5px] pl-6 py-2 relative\" data-kid=\"1-4-1-1-2\" data-name=\"year node list container\">\n                    <!-- Year Nodes with wiring -->\n                    <div class=\"relative py-2 group cursor-pointer\" data-kid=\"1-4-1-1-2-1\" data-name=\"active year node\">\n                        <div class=\"absolute left-[-25px] top-1/2 w-4 h-[1px] bg-[#e10600]\" data-kid=\"1-4-1-1-2-1-1\" data-name=\"active node indicator line\">\n                        </div>\n                        <span class=\"mono text-[14px] text-[#e10600] font-bold\" data-kid=\"1-4-1-1-2-1-2\" data-name=\"active year label\">\n                            2026\n                        </span>\n                        <!-- Races branch -->\n                        <div class=\"mt-4 flex flex-col gap-3 ml-2\" data-kid=\"1-4-1-1-2-1-3\" data-name=\"races branch container\">\n                            <div class=\"flex items-center gap-3 text-white/40 hover:text-white transition-all\" data-kid=\"1-4-1-1-2-1-3-1\" data-name=\"race link row\">\n                                <i class=\"ti ti-corner-down-right text-[12px]\" data-kid=\"1-4-1-1-2-1-3-1-1\" data-name=\"corner arrow icon\">\n                                </i>\n                                <span class=\"mono text-[11px] uppercase\" data-kid=\"1-4-1-1-2-1-3-1-2\" data-name=\"race title label\">\n                                    01 · BAHRAIN GP\n                                </span>\n                            </div>\n                            <div class=\"flex items-center gap-3 text-white/40 hover:text-white transition-all\" data-kid=\"1-4-1-1-2-1-3-2\" data-name=\"race link row\">\n                                <i class=\"ti ti-corner-down-right text-[12px]\" data-kid=\"1-4-1-1-2-1-3-2-1\" data-name=\"corner arrow icon\">\n                                </i>\n                                <span class=\"mono text-[11px] uppercase\" data-kid=\"1-4-1-1-2-1-3-2-2\" data-name=\"race title label\">\n                                    02 · SAUDI ARABIA GP\n                                </span>\n                            </div>\n                            <div class=\"flex items-center gap-3 text-white/40 hover:text-white transition-all\" data-kid=\"1-4-1-1-2-1-3-3\" data-name=\"race link row\">\n                                <i class=\"ti ti-corner-down-right text-[12px]\" data-kid=\"1-4-1-1-2-1-3-3-1\" data-name=\"corner arrow icon\">\n                                </i>\n                                <span class=\"mono text-[11px] uppercase\" data-kid=\"1-4-1-1-2-1-3-3-2\" data-name=\"race title label\">\n                                    03 · AUSTRALIA GP\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"relative py-4 group cursor-pointer\" data-kid=\"1-4-1-1-2-2\" data-name=\"year node row\">\n                        <div class=\"absolute left-[-25px] top-1/2 w-4 h-[1px] bg-white/10\" data-kid=\"1-4-1-1-2-2-1\" data-name=\"node indicator line\">\n                        </div>\n                        <span class=\"mono text-[14px] text-white/40 group-hover:text-white transition-all\" data-kid=\"1-4-1-1-2-2-2\" data-name=\"year label\">\n                            2025\n                        </span>\n                    </div>\n                    <div class=\"relative py-4 group cursor-pointer\" data-kid=\"1-4-1-1-2-3\" data-name=\"year node row\">\n                        <div class=\"absolute left-[-25px] top-1/2 w-4 h-[1px] bg-white/10\" data-kid=\"1-4-1-1-2-3-1\" data-name=\"node indicator line\">\n                        </div>\n                        <span class=\"mono text-[14px] text-white/40 group-hover:text-white transition-all\" data-kid=\"1-4-1-1-2-3-2\" data-name=\"year label\">\n                            2024\n                        </span>\n                    </div>\n                    <div class=\"relative py-4 group cursor-pointer\" data-kid=\"1-4-1-1-2-4\" data-name=\"year node row\">\n                        <div class=\"absolute left-[-25px] top-1/2 w-4 h-[1px] bg-white/10\" data-kid=\"1-4-1-1-2-4-1\" data-name=\"node indicator line\">\n                        </div>\n                        <span class=\"mono text-[14px] text-white/40 group-hover:text-white transition-all\" data-kid=\"1-4-1-1-2-4-2\" data-name=\"year label\">\n                            2023\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n    <!-- System Status Bar (Bottom) -->\n    <footer class=\"absolute bottom-0 left-0 right-0 z-30 bg-black/60 backdrop-blur-md border-t border-white/10 px-8 py-3\" data-kid=\"1-5\" data-name=\"system status footer\">\n        <div class=\"flex justify-between items-center\" data-kid=\"1-5-1\" data-name=\"footer inner layout\">\n            <div class=\"flex items-center gap-8\" data-kid=\"1-5-1-1\" data-name=\"system status indicators group\">\n                <div class=\"flex items-center gap-3\" data-kid=\"1-5-1-1-1\" data-name=\"api status container\">\n                    <div class=\"w-1.5 h-1.5 bg-[#1e9e50] rounded-full shadow-[0_0_8px_rgba(30,158,80,0.6)]\" data-kid=\"1-5-1-1-1-1\" data-name=\"api status light\">\n                    </div>\n                    <span class=\"mono text-[10px] text-white/60 uppercase\" data-kid=\"1-5-1-1-1-2\" data-name=\"api status label\">\n                        OPENF1 API: ONLINE\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-3\" data-kid=\"1-5-1-1-2\" data-name=\"uplink info container\">\n                    <span class=\"mono text-[10px] text-white/30 uppercase\" data-kid=\"1-5-1-1-2-1\" data-name=\"uplink label\">\n                        UPLINK:\n                    </span>\n                    <span class=\"mono text-[10px] text-white/60 uppercase\" data-kid=\"1-5-1-1-2-2\" data-name=\"uplink path\">\n                        D:\\FABLE\\APEX_OS_V01\n                    </span>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-8\" data-kid=\"1-5-1-2\" data-name=\"footer actions group\">\n                <div class=\"mono text-[10px] text-white/40 uppercase\" data-kid=\"1-5-1-2-1\" data-name=\"disclaimer text\">\n                    UNOFFICIAL CONCEPT · NO F1 ASSOCIATION\n                </div>\n                <button class=\"mono text-[10px] text-white hover:text-[#e10600] transition-all uppercase flex items-center gap-2\" data-kid=\"1-5-1-2-2\" data-name=\"system briefing button\">\n                    SYSTEM BRIEFING\n                    <i class=\"ti ti-arrow-up-right\" data-kid=\"1-5-1-2-2-1\" data-name=\"arrow up-right icon\">\n                    </i>\n                </button>\n            </div>\n        </div>\n    </footer>\n    <!-- Radar sweep line overlay -->\n    <div class=\"absolute inset-0 pointer-events-none opacity-5\" data-kid=\"1-6\" data-name=\"radar sweep line overlay\">\n        <div class=\"w-full h-full bg-[radial-gradient(circle_at_center,transparent_0%,rgba(225,6,0,0.2)_100%)]\" data-kid=\"1-6-1\" data-name=\"radial gradient effect layer\">\n        </div>\n    </div>\n</div>\n",
